    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const body = item.json.body || {};\n  const value = body.entry?.[0]?.changes?.[0]?.value || {};\n  const msg = value.messages?.[0];\n\n  // Status updates (sent/delivered/read) and non-text messages carry no order\n  if (!msg || msg.type !== 'text' || !msg.text?.body) continue;\n\n  const phone = msg.from;\n  const message = msg.text.body;\n  const profileName = value.contacts?.[0]?.profile?.name || null;\n\n  // Quantity\n  const qtyMatch = message.match(/\\b(\\d+)\\b/);\n  const quantity = qtyMatch ? parseInt(qtyMatch[1], 10) : 1;\n\n  // Table number\n  const tableMatch = message.match(/table\\s*(\\w+)/i);\n  const tableNo = tableMatch ? tableMatch[1] : null;\n\n  // Name (\"I'm Rahul\" or \"name: Rahul\"), falling back to the WhatsApp profile name\n  const nameMatch = message.match(/(?:i['\\u2019]?m|name[:\\s]+)\\s*([A-Za-z]+)/i);\n  const name = nameMatch ? nameMatch[1] : profileName;\n\n  // Item = what is left after removing quantity, table, name and filler words\n  const orderItem = message\n    .replace(/\\b\\d+\\b/, '')\n    .replace(/table\\s*\\w+/i, '')\n    .replace(/(?:i['\\u2019]?m|name[:\\s]+)\\s*[A-Za-z]+/i, '')\n    .replace(/\\b(please|order|want|give me|can i get)\\b/gi, '')\n    .trim()\n    .replace(/\\s+/g, ' ');\n\n  const menu = {\n    'cappuccino': 80, 'latte': 90,\n    'espresso': 60, 'cold brew': 100,\n    'croissant': 70, 'sandwich': 120,\n    'muffin': 60, 'tea': 40,\n  };\n\n  const itemLower = orderItem.toLowerCase();\n  const unitPrice = Object.entries(menu).find(([k]) => itemLower.includes(k))?.[1] || 0;\n  const totalPrice = unitPrice * quantity;\n\n  results.push({ json: { phone, name, item: orderItem, quantity, tableNo, totalPrice, rawMessage: message } });\n}\n\nreturn results;"
      },
